# Copy this file to .env (never commit .env) and set values as needed.
# Used by both `docker-compose up` and running the backend directly.

# Comma-separated origins the backend will accept CORS requests from.
# Default covers the local frontend dev server.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- LLM config (AI Assistant / RAG answer generation) ----
# The backend talks to any OpenAI-compatible endpoint via these three vars
# (see backend/llm.py) — NOT the OPENAI_API_KEY name used by the OpenAI SDK
# directly. Works unmodified with OpenAI, Groq (free tier), or local Ollama.

# Option A: OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-xxxx
# LLM_MODEL=gpt-4o-mini

# Option B: Groq (free, fast)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_groq_key_here
LLM_MODEL=llama-3.1-70b-versatile

# Option C: local Ollama (no key, no internet)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1

# ---- Storage paths ----
# Defaults below match docker-compose.yml's mounted ./data volume.
SQLITE_PATH=data/kmrl.db
CHROMA_DIR=data/chroma_db
UPLOAD_DIR=data/uploads

# Maximum size (in MB) accepted by POST /api/documents/upload.
MAX_UPLOAD_SIZE_MB=20
