# Copy this file to .env (never commit .env) and set values as needed.

# Comma-separated origins the backend will accept CORS requests from.
# Default covers the local frontend dev server.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# OpenAI API key — required for the AI Assistant / RAG answer generation.
OPENAI_API_KEY=sk-...

# Optional: Anthropic key if you switch LLM providers.
# ANTHROPIC_API_KEY=
