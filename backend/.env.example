# Copy this file to .env and fill in your values

# ---- LLM CONFIG ----
# Works with OpenAI, Groq (free tier), or a local Ollama server.
# Just change BASE_URL + API_KEY + MODEL_NAME depending on provider.

# Option A: OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-xxxx
# LLM_MODEL=gpt-4o-mini

# Option B: Groq (FREE, fast, good for hackathon demo)
# Get key from https://console.groq.com
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_groq_key_here
LLM_MODEL=llama-3.1-70b-versatile

# Option C: Local Ollama (no key needed, no internet needed)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1

# ---- APP CONFIG ----
UPLOAD_DIR=../data/uploads
CHROMA_DIR=../data/chroma_db
SQLITE_PATH=../data/kochi_metro.db
